{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aide",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": {
    "enabled": false,
  },
  "vars": {
    "VITE_CONVEX_URL": "https://kindred-quail-470.convex.cloud/",
    "VITE_CONVEX_SITE_URL": "https://kindred-quail-470.convex.site",
    "VITE_SITE_URL": "https://aide.fzn.workers.dev",
  },
}
