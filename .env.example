# Convex deployment
CONVEX_DEPLOYMENT=dev:your-project-name
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Site URL (for Better Auth callback URLs)
VITE_SITE_URL=http://localhost:3000

# Better Auth Secret (generate with: openssl rand -base64 32)
# Set in Convex dashboard: npx convex env set BETTER_AUTH_SECRET=...
BETTER_AUTH_SECRET=your-secret-here

# Resend (for OTP email delivery - set in Convex dashboard)
# npx convex env set RESEND_API_KEY=re_...
# RESEND_API_KEY=re_...

# OpenAI (for embeddings + agent LLM - set in Convex dashboard)
# npx convex env set OPENAI_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
